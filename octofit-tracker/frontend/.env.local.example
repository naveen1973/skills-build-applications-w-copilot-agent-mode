# OctoFit Tracker - React Frontend Environment Variables
# Copy this file to .env.local and update values as needed

# GitHub Codespaces Configuration
# Set to your Codespace name to use Codespaces API endpoints
# Find your CODESPACE_NAME by running: echo $CODESPACE_NAME in terminal
# Example: VITE_CODESPACE_NAME=my-project-abc123
VITE_CODESPACE_NAME=

# For Localhost Development
# Leave VITE_CODESPACE_NAME empty (as above) to use http://localhost:8000
# Ensure backend is running on port 8000:
#   npm run dev --prefix octofit-tracker/backend

# This file should NOT be committed to git
# .env.local is in .gitignore
